<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mauixui.Views.ProfileSelectionPage"
             Title="Выбор профиля"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              RowSpacing="20"
              Padding="20"
              VerticalOptions="Center">

            <!-- Заголовок -->
            <Label Grid.Row="0"
                   Text="👥 Выберите профиль"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

            <!-- Поле пароля -->
            <Frame Grid.Row="1"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}"
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="PasswordEntry"
                           Grid.Column="0"
                           Placeholder="Введите пароль (нажмите Enter для входа)"
                           IsPassword="True"
                           Completed="OnPasswordEntryCompleted"
                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                           PlaceholderColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                    <Button x:Name="ShowPasswordButton"
                            Grid.Column="1"
                            Text="👁️"
                            BackgroundColor="Transparent"
                            TextColor="#666666"
                            Clicked="OnShowPasswordClicked"/>
                </Grid>
            </Frame>

            <!-- Кнопка входа -->
            <Button Grid.Row="2"
                    Text="🔑 Войти"
                    BackgroundColor="#5865F2"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Clicked="OnLoginClicked"/>

            <!-- Список профилей -->
            <CollectionView x:Name="ProfilesCollectionView"
                           Grid.Row="3"
                           SelectionMode="Single"
                           SelectionChanged="OnProfileSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="15" 
                              ColumnDefinitions="Auto,*,Auto"
                              BackgroundColor="Transparent">

                            <Label Grid.Column="0"
                                   Text="{Binding Avatar}"
                                   FontSize="24"
                                   VerticalOptions="Center"/>

                            <VerticalStackLayout Grid.Column="1" 
                                                 VerticalOptions="Center"
                                                 Spacing="2">
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                                <Label Text="{Binding Email}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="➡️"
                                   FontSize="20"
                                   VerticalOptions="Center"
                                   TextColor="#666666"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Кнопка создания нового профиля -->
            <Button Grid.Row="4"
                    Text="➕ Создать новый профиль"
                    BackgroundColor="#23A55A"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Clicked="OnCreateNewProfileClicked"/>

            <!-- Кнопка отладки (можно удалить после тестирования) -->
            <!--<Button Grid.Row="5"
                    Text="🐞 Отладка Credentials"
                    BackgroundColor="Orange"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="40"
                    FontSize="12"
                    Clicked="OnDebugCredentialsClicked"/> -->

        </Grid>
    </ScrollView>
</ContentPage>