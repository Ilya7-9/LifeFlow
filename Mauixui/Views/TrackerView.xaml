<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microchartsMaui="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="Mauixui.Views.TrackerView">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">

            <!-- Заголовок и кнопки управления -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                <Label Text="📊 Трекер активности" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>

                <Button x:Name="RefreshButton"
                        Text="🔄 Обновить"
                        Grid.Column="1"
                        Margin="5,0"
                        Padding="10,5"
                        BackgroundColor="{DynamicResource AccentColor}"
                        TextColor="White"
                        Clicked="OnRefreshClicked"/>

                <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto">
                    <Button x:Name="StartTrackingButton"
                            Text="▶️"
                            Grid.Column="0"
                            Padding="10"
                            CornerRadius="20"
                            BackgroundColor="#23A55A"
                            TextColor="White"
                            Clicked="OnStartTrackingClicked"/>

                    <Button x:Name="StopTrackingButton"
                            Text="⏹️"
                            Grid.Column="1"
                            Padding="10"
                            CornerRadius="20"
                            BackgroundColor="#F23F43"
                            TextColor="White"
                            IsEnabled="False"
                            Clicked="OnStopTrackingClicked"/>
                </Grid>
            </Grid>

            <!-- Сегодняшняя статистика -->
            <Frame BorderColor="{DynamicResource AccentColor}" 
                   CornerRadius="10" 
                   Padding="15"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Сегодня" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentColor}"/>

                    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="10">

                        <!-- Общее время -->
                        <VerticalStackLayout Grid.Column="0" Grid.Row="0" HorizontalOptions="Center">
                            <Label Text="🕒 Общее время" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="TodayTimeLabel" Text="0ч 0м" FontSize="18" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Продуктивное время -->
                        <VerticalStackLayout Grid.Column="1" Grid.Row="0" HorizontalOptions="Center">
                            <Label Text="⚡ Продуктивно" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="ProductiveTimeLabel" Text="0ч 0м" FontSize="18" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Приложения -->
                        <VerticalStackLayout Grid.Column="2" Grid.Row="0" HorizontalOptions="Center">
                            <Label Text="📱 Приложения" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="AppsCountLabel" Text="0" FontSize="18" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Сайты -->
                        <VerticalStackLayout Grid.Column="3" Grid.Row="0" HorizontalOptions="Center">
                            <Label Text="🌐 Сайты" FontSize="12" TextColor="Gray"/>
                            <Label x:Name="WebsitesCountLabel" Text="0" FontSize="18" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Прогресс продуктивности -->
                        <Grid Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1" ColumnDefinitions="*,Auto">
                            <ProgressBar x:Name="ProductivityProgressBar" 
                                        Progress="0" 
                                        ProgressColor="#23A55A"
                                        BackgroundColor="#2F3136"
                                        HeightRequest="8"
                                        VerticalOptions="Center"/>
                            <Label x:Name="ProductivityPercentLabel" 
                                   Text="0%" 
                                   Grid.Column="1"
                                   Margin="10,0,0,0"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Текущая активность -->
            <Frame BorderColor="#404249" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Сейчас активны" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentColor}"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="10">

                        <!-- Приложение -->
                        <Label Text="Приложение:" 
                               Grid.Column="0" Grid.Row="0"
                               FontSize="14"
                               VerticalOptions="Center"/>

                        <Label x:Name="CurrentAppLabel" 
                               Text="Нет данных" 
                               Grid.Column="1" Grid.Row="0"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="End"/>

                        <!-- Время приложения -->
                        <Label Text="Время:" 
                               Grid.Column="0" Grid.Row="1"
                               FontSize="12"
                               TextColor="Gray"
                               VerticalOptions="Center"/>

                        <Label x:Name="CurrentAppTimeLabel" 
                               Text="0с" 
                               Grid.Column="1" Grid.Row="1"
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalOptions="End"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#404249" Margin="0,5"/>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="10">

                        <!-- Сайт -->
                        <Label Text="Сайт:" 
                               Grid.Column="0" Grid.Row="0"
                               FontSize="14"
                               VerticalOptions="Center"/>

                        <Label x:Name="CurrentWebsiteLabel" 
                               Text="Нет данных" 
                               Grid.Column="1" Grid.Row="0"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalOptions="End"/>

                        <!-- Время сайта -->
                        <Label Text="Время:" 
                               Grid.Column="0" Grid.Row="1"
                               FontSize="12"
                               TextColor="Gray"
                               VerticalOptions="Center"/>

                        <Label x:Name="CurrentWebsiteTimeLabel" 
                               Text="0с" 
                               Grid.Column="1" Grid.Row="1"
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalOptions="End"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#404249" Margin="0,5"/>

                    <!-- Время сессии -->
                    <Grid ColumnDefinitions="*,Auto" RowSpacing="5" ColumnSpacing="10">
                        <Label Text="Время сессии:" 
                               FontSize="12"
                               TextColor="Gray"
                               VerticalOptions="Center"/>

                        <Label x:Name="SessionTimeLabel" 
                               Text="0ч 0м" 
                               FontSize="12"
                               TextColor="Gray"
                               HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Недельная статистика -->
            <Frame BorderColor="#404249" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Недельная активность" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentColor}"/>

                    <microchartsMaui:ChartView x:Name="WeeklyChartView" 
                                               HeightRequest="150"
                                               BackgroundColor="Transparent"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Топ приложений и сайтов -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                <!-- Топ приложений -->
                <Frame BorderColor="#404249" CornerRadius="10" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🔥 Топ приложений" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentColor}"/>

                            <Button Text="Все →"
                                    Grid.Column="1"
                                    Padding="5"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource AccentColor}"
                                    Clicked="OnViewAllAppsClicked"/>
                        </Grid>

                        <VerticalStackLayout x:Name="TopAppsStackLayout" Spacing="5">
                            <!-- Динамически заполняется -->
                            <Label Text="Нет данных за сегодня" 
                                   FontSize="14" 
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   Margin="0,10"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Топ сайтов -->
                <Frame BorderColor="#404249" CornerRadius="10" Padding="15" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="🌐 Топ сайтов" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AccentColor}"/>

                            <Button Text="Все →"
                                    Grid.Column="1"
                                    Padding="5"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource AccentColor}"
                                    Clicked="OnViewAllWebsitesClicked"/>
                        </Grid>

                        <VerticalStackLayout x:Name="TopWebsitesStackLayout" Spacing="5">
                            <!-- Динамически заполняется -->
                            <Label Text="Нет данных за сегодня" 
                                   FontSize="14" 
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   Margin="0,10"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Анализ продуктивности -->
            <Frame BorderColor="#404249" CornerRadius="10" Padding="15" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="📈 Анализ продуктивности" 
                           FontSize="16" 
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AccentColor}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                        <!-- Продуктивное время -->
                        <Frame BackgroundColor="#1A4423" CornerRadius="10" Padding="15">
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Label Text="👍 Продуктивное" 
                                       FontSize="14" 
                                       TextColor="#4CD964"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="ProductiveTimeCard" 
                                       Text="0ч 0м" 
                                       FontSize="20" 
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Label Text="Разработка, Офис, Обучение" 
                                       FontSize="12" 
                                       TextColor="#8CD98C"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Отвлекающее время -->
                        <Frame BackgroundColor="#44231A" CornerRadius="10" Padding="15">
                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                <Label Text="👎 Отвлечения" 
                                       FontSize="14" 
                                       TextColor="#FF6B6B"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="DistractingTimeCard" 
                                       Text="0ч 0м" 
                                       FontSize="20" 
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Label Text="Соцсети, Игры, Видео" 
                                       FontSize="12" 
                                       TextColor="#FF9999"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>

                    <!-- Круговая диаграмма -->
                    <microchartsMaui:ChartView x:Name="ProductivityChartView" 
                                               HeightRequest="200"
                                               BackgroundColor="Transparent"
                                               Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Кнопка очистки истории -->
            <Button Text="🗑️ Очистить историю"
                    BackgroundColor="#2F3136"
                    TextColor="#F23F43"
                    Margin="0,10,0,0"
                    Padding="15,10"
                    CornerRadius="10"
                    Clicked="OnClearHistoryClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>