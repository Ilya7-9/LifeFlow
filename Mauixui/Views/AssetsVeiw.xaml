<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mauixui.Views.AssetsView"
             BackgroundColor="#1E1E1E">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="🏦 Активы и долги" FontSize="24" TextColor="White" FontAttributes="Bold"/>

        <!-- Итоги -->
        <Frame BackgroundColor="#2D2D30" CornerRadius="12" Padding="10">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <VerticalStackLayout>
                    <Label Text="Общие активы" TextColor="#BBBBBB" FontSize="12"/>
                    <Label x:Name="TotalAssetsLabel" Text="0 Br" FontSize="18" TextColor="#23D160" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Общие долги" TextColor="#BBBBBB" FontSize="12"/>
                    <Label x:Name="TotalDebtsLabel" Text="0 Br" FontSize="18" TextColor="#FF4B4B" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Чистый капитал" TextColor="#BBBBBB" FontSize="12"/>
                    <Label x:Name="NetWorthLabel" Text="0 Br" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <!-- Форма добавления -->
        <Frame BackgroundColor="#2D2D30" CornerRadius="12" Padding="10">
            <VerticalStackLayout Spacing="8">

                <HorizontalStackLayout Spacing="8">
                    <Picker x:Name="TypePicker" Title="Тип" WidthRequest="140">
                        <Picker.Items>
                            <x:String>Актив</x:String>
                            <x:String>Долг</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker x:Name="CategoryPicker" Title="Категория" WidthRequest="160">
                        <Picker.Items>
                            <x:String>Наличные</x:String>
                            <x:String>Банк (карта)</x:String>
                            <x:String>Инвестиции</x:String>
                            <x:String>Криптовалюта</x:String>
                            <x:String>Недвижимость</x:String>
                            <x:String>Техника</x:String>
                            <x:String>Авто</x:String>
                            <x:String>Другое</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker x:Name="DebtDirectionPicker" Title="Кто кому" WidthRequest="160" IsVisible="False">
                        <Picker.Items>
                            <x:String>Мне должны</x:String>
                            <x:String>Я должен</x:String>
                        </Picker.Items>
                    </Picker>

                </HorizontalStackLayout>

                <Entry x:Name="NameEntry" Placeholder="Название (например: Карта Тинькофф)" 
                       BackgroundColor="#40444B" TextColor="White" PlaceholderColor="#888888"/>

                <Entry x:Name="ValueEntry" Placeholder="Сумма Br" Keyboard="Numeric"
                       BackgroundColor="#40444B" TextColor="White" PlaceholderColor="#888888"/>

                <HorizontalStackLayout Spacing="8">
                    <DatePicker x:Name="DatePicker" Format="dd.MM.yyyy" TextColor="White"/>
                    <Entry x:Name="InterestEntry" Placeholder="Процент (для долга, %)"
                           Keyboard="Numeric" WidthRequest="140" BackgroundColor="#40444B" TextColor="White" PlaceholderColor="#888888"/>
                </HorizontalStackLayout>

                <Entry x:Name="NotesEntry" Placeholder="Заметки (по желанию)" BackgroundColor="#40444B" TextColor="White" PlaceholderColor="#888888"/>

                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Button Text="Добавить" BackgroundColor="#4CAF50" TextColor="White" Clicked="AddItemClicked"/>
                    <Button Text="Очистить" BackgroundColor="#FF4B4B" TextColor="White" Clicked="ClearFormClicked"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Списки -->
        <Label Text="Список активов" TextColor="White" FontAttributes="Bold" />
        <ScrollView HeightRequest="150">
            <VerticalStackLayout x:Name="AssetsList" Spacing="8" Padding="0"/>
        </ScrollView>

        <Label Text="Список долгов" TextColor="White" FontAttributes="Bold" />
        <ScrollView HeightRequest="150">
            <VerticalStackLayout x:Name="DebtsList" Spacing="8" Padding="0"/>
        </ScrollView>

    </VerticalStackLayout>
</ContentView>
