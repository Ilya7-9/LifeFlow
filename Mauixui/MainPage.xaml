<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mauixui.MainPage"
             xmlns:views="clr-namespace:Mauixui.Views"
             BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">

    <!-- ЕДИНСТВЕННОЕ СОДЕРЖИМОЕ CONTENTPAGE -->
    <Grid>

        <!-- ИНДИКАТОР ЗАГРУЗКИ -->
        <Grid x:Name="LoadingGrid" IsVisible="True">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20">
                <ActivityIndicator IsRunning="True"
                                   Color="#5865F2"
                                   WidthRequest="50"
                                   HeightRequest="50"/>
                <Label Text="Загрузка приложения..."
                       TextColor="White"
                       FontSize="16"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

        <!-- ОСНОВНОЙ ИНТЕРФЕЙС -->
        <Grid x:Name="MainGrid" IsVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Левая панель -->
            <Grid Grid.Column="0"
                  BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryLight}, Dark={StaticResource SecondaryDark}}"
                  RowDefinitions="Auto,*,Auto"
                  VerticalOptions="FillAndExpand"
                  Padding="20,30">

                <!-- Верхняя часть -->
                <VerticalStackLayout Spacing="15" VerticalOptions="CenterAndExpand">

                    <Button x:Name="ProfileButton"
                            Text="👤"
                            BorderWidth="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ActiveItemLight}, Dark={StaticResource ActiveItemDark}}"
                            FontSize="62"
                            HeightRequest="100"
                            CornerRadius="10"
                            TextColor="{StaticResource White}" />

                    <Button x:Name="FinanceButton"
                            Text="💸"
                            BorderWidth="0"
                            BackgroundColor="{StaticResource Transparent}"
                            FontSize="62"
                            HeightRequest="100"
                            CornerRadius="10"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>

                    <Button x:Name="TrackButton"
                            Text="⏱"
                            BorderWidth="0"
                            BackgroundColor="{StaticResource Transparent}"
                            FontSize="62"
                            HeightRequest="100"
                            CornerRadius="10"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                </VerticalStackLayout>

                <!-- Нижняя часть -->
                <VerticalStackLayout Grid.Row="2"
                                     Spacing="15"
                                     Margin="0,30,0,0"
                                     VerticalOptions="End">

                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Тёмная тема"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />

                        <Switch x:Name="ThemeSwitch"
                                Toggled="OnThemeSwitchToggled"
                                OnColor="{StaticResource AccentLight}"
                                ThumbColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- Основной контент -->
            <Grid x:Name="MainContent"
                  Grid.Column="1"
                  Padding="25"
                  BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
        </Grid>

    </Grid>
</ContentPage>
