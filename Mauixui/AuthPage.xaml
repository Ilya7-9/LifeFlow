<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mauixui.Views.AuthPage"
             Title="Авторизация"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1E1E1E}">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="20"
              Padding="30"
              VerticalOptions="Center">

            <!-- Заголовок -->
            <Label Grid.Row="0"
                   Text="🔐 Органайзер"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

            <Label Grid.Row="1"
                   Text="Войдите в свой аккаунт"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

            <!-- Поле email -->
            <Frame Grid.Row="2"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}"
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <Entry x:Name="EmailEntry"
                       Placeholder="Email"
                       Keyboard="Email"
                       TextChanged="OnFieldsChanged"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                       PlaceholderColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
            </Frame>

            <!-- Поле пароля -->
            <Frame Grid.Row="3"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2D2D30}"
                   CornerRadius="10"
                   Padding="15"
                   HasShadow="True">
                <Entry x:Name="PasswordEntry"
                       Placeholder="Пароль"
                       IsPassword="True"
                       TextChanged="OnFieldsChanged"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                       PlaceholderColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
            </Frame>

            <!-- Кнопка входа -->
            <Button x:Name="LoginButton"
                    Grid.Row="4"
                    Text="Войти"
                    BackgroundColor="#5865F2"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Clicked="OnLoginClicked"
                    IsEnabled="False"/>

            <!-- Ссылка на регистрацию -->
            <Button Grid.Row="5"
                    Text="Нет аккаунта? Зарегистрироваться"
                    BackgroundColor="Transparent"
                    TextColor="#5865F2"
                    Clicked="OnRegisterClicked"/>

        </Grid>
    </ScrollView>
</ContentPage>